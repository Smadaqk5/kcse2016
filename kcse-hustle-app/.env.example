# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Server only; never expose to the client or commit real values
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# --- Postgres for Prisma (Dashboard → Project Settings → Database) ---
# Session pooler (port 5432 or 6543 per Supabase UI) — good for serverless / many connections:
# DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection — required for prisma migrate (use as DIRECT_URL; can also be DATABASE_URL for local dev):
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

JWT_SECRET="replace-with-strong-random-secret"

# Lipana STK
LIPANA_BASE_URL="https://api.lipana.dev/v1"
LIPANA_SECRET_KEY="lip_sk_test_your_secret_key"
LIPANA_WEBHOOK_SECRET="your_lipana_webhook_secret"
MPESA_SIMULATE_SUCCESS="true"

DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="Admin@12345"
DEFAULT_USER_USERNAME="student"
DEFAULT_USER_PASSWORD="Student@12345"
DEFAULT_USER_PHONE="254712345678"
